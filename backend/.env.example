# Read by Program.cs at startup (variables already set in the environment win).
# Key and endpoint resolution is the showcase's ApiKeyResolver.cs:
#   key:      OPENAI_API_KEY > GitHubToken
#   endpoint: OPENAI_BASE_URL, else https://models.inference.ai.azure.com
#             (GitHub Models) — so set OPENAI_BASE_URL when using an OpenAI key.

# --- Option 1: OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL_ID=gpt-5.4-mini

# --- Option 2: GitHub Models (the showcase default) ---
# GitHubToken=ghp_...   # gh auth token
# (leave OPENAI_BASE_URL unset)

# Note: the sub-agents supervisor (SubagentsAgent.cs, from the showcase) does
# not read OPENAI_CHAT_MODEL_ID. It hard-codes the model "gpt-6-luna".

# PORT=8241
