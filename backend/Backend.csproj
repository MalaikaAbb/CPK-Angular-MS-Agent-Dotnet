<!--
  Project settings and package pins from the CopilotKit showcase,
  showcase/integrations/ms-agent-dotnet/agent/ProverbsAgent.csproj — the source
  https://docs.copilotkit.ai/angular/ms-agent-dotnet/multi-agent/subagents
  quotes. Those pins are what make the guide's C# (AgentThread,
  AgentRunResponse, RunAsync/RunStreamingAsync overrides) compile; later
  Microsoft.Agents.AI releases renamed all of them.

  Differences from the showcase project:
  - Only the files this harness uses are compiled (EnableDefaultCompileItems
    is off and each file is listed).
  - The showcase's ..\_shared\dotnet\LunaChatClientExtensions.cs lives in
    shared/ here, unchanged. Its CVDIAG sources and the showcase's aimock /
    ApiKeyResolver helpers are left out (see CLAUDE.md, "Showcase-only code").
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Run on a newer major runtime when .NET 9 is absent (e.g. a .NET 10-only machine). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Self-defined host. -->
    <Compile Include="Program.cs" />
    <!-- Showcase (SubagentsAgent.cs: only its OpenAIClient setup changed). -->
    <Compile Include="SubagentsAgent.cs" />
    <Compile Include="shared\LunaChatClientExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.0.0-preview.251110.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.10.2-preview.1.25552.1" />
    <PackageReference Include="OpenAI" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.env')" />
  </ItemGroup>

</Project>
